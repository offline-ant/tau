{
  "name": "pi-tau-web-server",
  "version": "1.2.1",
  "description": "Web browser workspace for Pi — a standalone web server that manages multiple live Pi RPC sessions in parallel.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "pi-tau",
    "tau",
    "pi-web",
    "pi-web-ui",
    "pi-webui",
    "pi-web-server",
    "pi-ui",
    "pi-rpc",
    "pi-session",
    "pi-session-manager",
    "pi-extensions",
    "ai-agent",
    "ai-coding-agent",
    "coding-agent",
    "harness",
    "llm",
    "web-ui",
    "webui",
    "web-server",
    "websocket",
    "rpc",
    "standalone",
    "multi-session",
    "self-hosted",
    "pwa",
    "mobile"
  ],
  "author": {
    "name": "Milan Glacier",
    "email": "dev@milanglacier.com",
    "url": "https://github.com/milanglacier"
  },
  "contributors": [
    {
      "name": "deflating",
      "url": "https://github.com/deflating"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/offline-ant/tau#readme",
  "bugs": {
    "url": "https://github.com/offline-ant/tau/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offline-ant/tau.git"
  },
  "type": "module",
  "main": "./bin/tau.js",
  "bin": {
    "pi-tau-web-server": "./bin/tau.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin",
    "public",
    "scripts",
    "src",
    "vendor",
    "docs/phimacs-candidate.md",
    "tsconfig.json",
    "tsconfig.server.json",
    "tsconfig.public.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.public.json && node scripts/copy-katex.ts && node scripts/copy-highlight.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.public.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && node --test test/*.test.ts",
    "test:e2e": "bash scripts/e2e.sh"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@phimacs/pimux": "file:vendor/phimacs-pimux-0.1.0-943308be88ad.tgz",
    "pi-orchestration": "file:vendor/pi-orchestration-0.1.0-c0ce15b13564.tgz",
    "pi-sound": "file:vendor/pi-sound-0.1.0.tgz",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "katex": "0.18.7",
    "playwright": "1.61.1",
    "typescript": "5.9.3"
  }
}
